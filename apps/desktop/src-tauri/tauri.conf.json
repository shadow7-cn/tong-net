{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "同网互通",
  "version": "0.1.1",
  "identifier": "com.tingxi.tongnet",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:17281",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "同网互通",
        "width": 1180,
        "height": 760,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/easytier-core",
      "binaries/easytier-cli"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
